# Copy this file to .env and fill in real values.

# --- 01 Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=annual-reports

# --- 02 Document Intelligence ---
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_KEY=

# --- 03 Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- 04 AI Search ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=risklens-chunks

# --- 05 Cosmos DB Gremlin ---
# Use the wss:// gremlin endpoint, NOT the documents.azure.com one
COSMOS_GREMLIN_ENDPOINT=
COSMOS_GREMLIN_KEY=
COSMOS_DATABASE=risklens
COSMOS_GRAPH=riskgraph

# --- 06 Content Safety ---
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
